/*
 * Enable IMX477 (RBPv3) camera sensor on A603 carrier board W9 connector.
 *
 * Fixes applied on top of the base tegra234-p3768-camera-rbpcv3-imx477.dtsi:
 *
 * 1. GPIO hog: the base DTS drives CAM0_PWDN (PH.06, GPIO 62) output-low
 *    at boot via camera-control-output-low, holding the IMX477 in reset and
 *    causing EBUSY when the driver tries to claim it. Delete the hog so the
 *    driver owns and manages PH.06 via its reset-gpios property.
 *
 * 2. CSI interface: the base mode tables target serial_a / port-index=0
 *    (NVIDIA reference devkit). The A603 W9 connector physically routes to
 *    NVCSI brick 1 (serial_b, port-index=1). Override all three layers:
 *    sensor modes, VI input endpoint, and NVCSI channel endpoint.
 *
 * lane_polarity="6" (DATA0+DATA1 inverted) is already correct in the base
 * DTSI for the A603 W9 PCB traces; no override needed.
 *
 * Copyright (c) 2024, Sighthound Inc. All rights reserved.
 */
/ {
	cam_i2cmux {
		i2c@0 {
			/* Enable IMX477 on mux channel 0 (Linux I2C bus 9, addr 0x1a) */
			rbpcv3_imx477_a@1a {
				status = "okay";

				/*
				 * A603 W9 routes to NVCSI brick 0 (serial_a, port-index=0).
				 * Confirmed empirically: serial_a + lane_polarity=6 is the
				 * correct mapping for the A603 CSI connector.
				 */
				mode0 {
					tegra_sinterface = "serial_a";
				};
				mode1 {
					tegra_sinterface = "serial_a";
				};
				ports {
					port@0 {
						endpoint {
							port-index = <0>;
						};
					};
				};
			};
		};
		/* Disable second-slot camera nodes to prevent RTCPU VI channel conflicts.
		 * Also delete their ports nodes to remove phandle references to
		 * rbpcv3_imx477_csi_in1 and rbpcv2_imx219_csi_in1 which live in
		 * NVCSI channel@1 (deleted above). Without this, DTC errors on
		 * phandle_references check. */
		i2c@1 {
			rbpcv3_imx477_c@1a {
				status = "disabled";
				/delete-node/ ports;
			};
			rbpcv2_imx219_c@10 {
				status = "disabled";
				/delete-node/ ports;
			};
		};
	};

	/* Match VI input port-index to serial_a (brick 0), delete dangling port@1 */
	tegra-capture-vi {
		num-channels = <1>;
		ports {
			/delete-node/ port@1;
			port@0 {
				endpoint {
					port-index = <0>;
				};
			};
		};
	};

	/* Match NVCSI channel port-index to serial_a (brick 0), delete dangling channel@1 */
	host1x@13e00000 {
		nvcsi@15a00000 {
			num-channels = <1>;
			/delete-node/ channel@1;
			channel@0 {
				ports {
					port@0 {
						endpoint@0 {
							port-index = <0>;
						};
					};
				};
			};
		};
	};

	/*
	 * Remove CAM0_PWDN (PH.06 / GPIO 62) from the gpio-hog entirely.
	 * The base DTS camera-control-output-low hog drives it output-low
	 * at boot (sensor in reset) and blocks the driver with EBUSY.
	 * The imx477 driver manages PH.06 itself via reset-gpios.
	 */
	gpio@6000d000 {
		/delete-node/ camera-control-output-low;
	};

	tegra-camera-platform {
		modules {
			/*
			 * Disable module1 (second camera slot). It also targets serial_b
			 * and would claim the same RTCPU VI channel match config as module0.
			 * Without this, VI channel allocation fails with "channel 35 in use".
			 */
			/delete-node/ module1;
		};
	};
};
